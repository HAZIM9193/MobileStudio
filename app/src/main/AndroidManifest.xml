<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Roblox's APIs (sign-in, games, Creator Store, assets) and, only after the user allows a
         site, HttpService requests from scripts and plugins. -->

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:name=".StudioApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:resizeableActivity="true"
        android:largeHeap="true"
        android:theme="@style/Theme.Mobilestudiotest">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lets "Open with" offer this app for Roblox files -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-roblox-rbxl" />
                <data android:mimeType="application/x-roblox-rbxm" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
            </intent-filter>
            <!-- Roblox files recognised by their extension (file managers often give no useful MIME type) -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.rbxl" />
                <data android:pathPattern=".*\\..*\\.rbxl" />
                <data android:pathPattern=".*\\..*\\..*\\.rbxl" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.rbxl" />
                <data android:pathPattern=".*\\.rbxm" />
                <data android:pathPattern=".*\\..*\\.rbxm" />
                <data android:pathPattern=".*\\..*\\..*\\.rbxm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.rbxm" />
                <data android:pathPattern=".*\\.rbxlx" />
                <data android:pathPattern=".*\\..*\\.rbxlx" />
                <data android:pathPattern=".*\\..*\\..*\\.rbxlx" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.rbxlx" />
                <data android:pathPattern=".*\\.rbxmx" />
                <data android:pathPattern=".*\\..*\\.rbxmx" />
                <data android:pathPattern=".*\\..*\\..*\\.rbxmx" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.rbxmx" />
            </intent-filter>
            <!-- Share sheet: Share -> Mobile Studio -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-roblox-rbxl" />
                <data android:mimeType="application/x-roblox-rbxm" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
            </intent-filter>
        </activity>
    </application>

</manifest>
